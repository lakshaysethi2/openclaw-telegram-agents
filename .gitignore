# Secrets and local env
.env
**/.env
!**/.env.example
# Live operator metadata (bot usernames/ids from setup) - never commit
agents/stack-public.json
*.pem
*.key
credentials/
secrets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# OpenClaw runtime (keep committed templates only)
agents/*/auth/**
!agents/*/auth/.gitkeep
# Live state is local-only (contains Telegram user/bot/group ids).
# Commit only openclaw.json.example placeholders under agents/*/state/.
agents/*/state/**
!agents/*/state/.gitkeep
!agents/*/state/openclaw.json.example
agents/*/workspace/**
# Live persona/identity is local-only (may contain private operator notes).
# Commit only *.example templates.
!agents/*/workspace/IDENTITY.md.example
!agents/*/workspace/.gitkeep

# DBs / sessions / logs
**/*.sqlite
**/*.sqlite-*
**/*.db
**/sessions/
**/*.jsonl
**/*.log
logs/
tmp/
.cache/
.DS_Store
