# Secrets and local env
.env
**/.env
!**/.env.example
# Live operator metadata (bot usernames from setup); not a secret but local
agents/stack-public.json
*.pem
*.key
credentials/
secrets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# OpenClaw runtime (keep committed templates only)
agents/*/auth/**
!agents/*/auth/.gitkeep
agents/*/state/**
!agents/*/state/openclaw.json
agents/*/workspace/**
!agents/*/workspace/IDENTITY.md
!agents/*/workspace/.gitkeep

# DBs / sessions / logs
**/*.sqlite
**/*.sqlite-*
**/*.db
**/sessions/
**/*.jsonl
**/*.log
logs/
tmp/
.cache/
.DS_Store
