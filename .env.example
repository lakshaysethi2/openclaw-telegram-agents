# Root compose settings. Copy to .env (gitignored).
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Optional notes for operators (not read by compose).
# Never put real Telegram user/bot/group ids in committed files.
# OWNER_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# Per-agent secrets live in agents/<name>/.env
# Example keys (filled by make setup / setup_agents.py):
# agents/agent-1/.env -> TELEGRAM_BOT_TOKEN=...
# agents/agent-1/.env -> OPENCLAW_GATEWAY_TOKEN=...
# agents/agent-1/.env -> DEEPSEEK_API_KEY=...
# agents/agent-2/.env -> TELEGRAM_BOT_TOKEN=...
# agents/agent-2/.env -> OPENCLAW_GATEWAY_TOKEN=...
# agents/agent-2/.env -> DEEPSEEK_API_KEY=...
